<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net452</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>7.3</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>QuanLyHeThong</AssemblyName>
    <Product>Quản Lý Hệ Thống</Product>
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
    <Platforms>AnyCPU</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Assembly khung của .NET Framework (WMI) — nằm sẵn trong máy, không tạo file phụ -->
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <!-- PsExec (Microsoft Sysinternals) NHÚNG thẳng vào exe — app tự giải nén khi cần, không cần chép kèm -->
    <EmbeddedResource Include="PsExec.exe">
      <LogicalName>PsExec.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Chỉ để GitHub (máy CI) có bộ reference .NET Framework 4.5.2 khi build. Không đi kèm file đầu ra. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net452" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
